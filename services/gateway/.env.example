# Copy to .env. NEVER commit real values.
ENV=dev
LOG_LEVEL=INFO
# Comma separated browser origins (web build). Native apps ignore CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Set when running behind a reverse proxy so X-Forwarded-For is used for per-IP limits.
TRUST_PROXY=false

# --- Auth: Supabase user JWT (Settings -> API -> JWT secret) for HS256 projects,
# or the JWKS URL for projects with asymmetric signing keys: https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Only needed for /v1/lastfm (stores the Last.fm session key in scrobble_accounts). Server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cache / rate limit state. Empty = in-memory (single instance only).
REDIS_URL=

# --- Providers
AUDIUS_APP_NAME=zoyra
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
TICKETMASTER_API_KEY=
YOUTUBE_API_KEY=

# --- Tunables (seconds / requests per minute per IP; signed-in users get RL_USER_MULTIPLIER x)
TTL_AUDIUS=300
TTL_AUDIUS_DETAIL=1800
TTL_LYRICS=604800
TTL_LYRICS_MISS=21600
TTL_LIBRIVOX=1800
TTL_CONCERTS=900
TTL_STALE=86400
RL_DEFAULT=120
RL_AUDIUS=240
RL_LYRICS=120
RL_LIBRIVOX=60
RL_YOUTUBE=60
RL_LASTFM=60
RL_CONCERTS=30
RL_SPOTIFY=60
RL_LISTENBRAINZ=60
RL_USER_MULTIPLIER=3
