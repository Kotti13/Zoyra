+package expo.modules.audio.service
+
+import android.os.Handler
+import android.os.Looper
+import expo.modules.kotlin.records.Field
+import expo.modules.kotlin.records.Record
+import java.lang.ref.WeakReference
+
+/**
+ * Zoyra patch: Like and Shuffle buttons on the media notification / lock screen card.
+ *
+ * Holds the button state pushed from JS (`setLockScreenButtons`) and forwards taps back to JS
+ * (`onLockScreenAction`). The state lives here, not on the session, because expo-audio rebuilds the
+ * MediaSession whenever lock-screen options change.
+ */
+object ZoyraLockScreenButtons {
+  const val ACTION_TOGGLE_LIKE = "zoyra.TOGGLE_LIKE"
+  const val ACTION_TOGGLE_SHUFFLE = "zoyra.TOGGLE_SHUFFLE"
+
+  @Volatile var liked: Boolean = false
+  @Volatile var shuffle: Boolean = false
+
+  // Hidden until JS opts in, so the stock behaviour is unchanged for callers that never set them.
+  @Volatile var showLike: Boolean = false
+  @Volatile var showShuffle: Boolean = false
+
+  /** Set by AudioModule; emits `onLockScreenAction` to JS. */
+  @Volatile var actionListener: ((String) -> Unit)? = null
+
+  private var serviceRef: WeakReference<AudioControlsService>? = null
+  private val mainHandler = Handler(Looper.getMainLooper())
+
+  fun attach(service: AudioControlsService) {
+    serviceRef = WeakReference(service)
+  }
+
+  fun detach(service: AudioControlsService) {
+    if (serviceRef?.get() === service) {
+      serviceRef = null
+    }
+  }
+
+  fun update(options: LockScreenButtonsOptions) {
+    liked = options.liked
+    shuffle = options.shuffle
+    showLike = options.showLike
+    showShuffle = options.showShuffle
+    mainHandler.post {
+      serviceRef?.get()?.refreshZoyraButtons()
+    }
+  }
+
+  /** Called for taps from the notification, lock screen, Bluetooth/Auto/Wear controllers. */
+  fun emit(action: String) {
+    val listener = actionListener ?: return
+    try {
+      listener(action)
+    } catch (_: Throwable) {
+      // Never crash the playback service because JS is gone.
+    }
+  }
+}
+
+class LockScreenButtonsOptions : Record {
+  @Field val liked: Boolean = false
+
+  @Field val shuffle: Boolean = false
+
+  @Field val showLike: Boolean = false
+
+  @Field val showShuffle: Boolean = false
+}
