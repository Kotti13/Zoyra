{
  "expo": {
    "name": "Zoyra",
    "slug": "zoyra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "NSSpeechRecognitionUsageDescription": "Zoyra uses speech recognition to turn what you say into a search.",
        "NSMicrophoneUsageDescription": "Zoyra uses the microphone for voice and video calls, voice search, karaoke and to recognise songs around you."
      },
      "bundleIdentifier": "com.zoyra.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#FA2D48"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zoyra.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.INTERNET",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.CALL_PHONE",
        "android.permission.READ_PHONE_NUMBERS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#050505",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#050505"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Zoyra uses the microphone for voice and video calls, karaoke and to recognise songs around you.",
          "enableBackgroundPlayback": true
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Zoyra uses the camera for video calls, to scan Zoyra QR codes and, if you choose, to read your mood for a matching mix.",
          "microphonePermission": "Zoyra uses the microphone for voice and video calls, to recognise songs around you and for karaoke.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FA2D48",
          "sounds": [
            "./assets/sounds/zoyra_chime.wav",
            "./assets/sounds/zoyra_ring.wav",
            "./assets/sounds/zoyra_ringback.wav",
            "./assets/sounds/zoyra_gold_ring.wav"
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Zoyra uses the microphone for voice search, karaoke and to recognise songs around you.",
          "speechRecognitionPermission": "Zoyra uses speech recognition to turn what you say into a search.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Zoyra uses your media library to find audio files saved on this device so you can play them.",
          "savePhotosPermission": false,
          "granularPermissions": [
            "audio"
          ],
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-asset",
      [
        "expo-sensors",
        {
          "motionPermission": "Zoyra counts your steps during Run mode to show your cadence and match the music's tempo."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Zoyra uses your location while Run mode is open to measure your distance, pace and route.",
          "motionUsagePermission": "Zoyra counts your steps during Run mode to show your cadence and match the music's tempo.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-secure-store",
      "@config-plugins/react-native-callkeep",
      "./plugins/withZoyraCalls",
      "./plugins/withZoyraNSE"
    ],
    "scheme": "zoyra",
    "backgroundColor": "#050505",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6f208010-3b53-417e-b56f-dbaa924ebdc7"
      }
    },
    "owner": "kottai13s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6f208010-3b53-417e-b56f-dbaa924ebdc7"
    },
    "experiments": {
      "reactCompiler": true
    }
  }
}