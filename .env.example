# Public (safe in the app bundle)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<publishable key>
# Optional integrations — features show "coming soon" until set
# Zoyra backend (song search, stream, lyrics, mp3 download). Unset = Audius only.
EXPO_PUBLIC_ZOYRA_API_URL=https://zoyra.tail856066.ts.net
# Rich share links host (web/share on Vercel). Also drives iOS associatedDomains + Android App Links
# in app.config.js, so changing it needs a new native build. Set the same value for EAS builds.
EXPO_PUBLIC_SHARE_HOST=https://zoyra-share.vercel.app
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Server-only secrets: NEVER put these in .env for the app.
# Set them on Supabase:  supabase secrets set NAME=value
#   ANTHROPIC_API_KEY      AI playlist, AI DJ script, mood from photo
#   ACRCLOUD_HOST / ACRCLOUD_ACCESS_KEY / ACRCLOUD_ACCESS_SECRET   song recognition
#   TICKETMASTER_API_KEY   concerts near you
#   YOUTUBE_API_KEY        music videos (YouTube Data API v3; official embedded player only)
#   REVENUECAT_WEBHOOK_AUTH   verifies RevenueCat webhooks → profiles.plan
#   PUSH_WEBHOOK_SECRET    shared with Vault secret 'push_webhook_secret' (DB → push function)
#   EXPO_ACCESS_TOKEN (optional)   push notifications via Expo push service
EXPO_PUBLIC_ZOYRA_API_KEY=
