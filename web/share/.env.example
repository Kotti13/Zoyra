# Copy into Vercel → Project → Settings → Environment Variables (Production), or `vercel env add NAME production`.
# For `vercel dev` locally: `vercel env pull .env.local` (never commit it).

# Public origin of this site. Must match EXPO_PUBLIC_SHARE_HOST in the app.
PUBLIC_HOST=https://zoyra-share.vercel.app

# Supabase project URL + anon / publishable key (same values as EXPO_PUBLIC_SUPABASE_URL / _KEY).
# NEVER the service-role key. Only the share_playlist_card / share_profile_card RPCs are readable by anon.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon or sb_publishable_ key>

# iOS Universal Links: 10-character Apple Developer Team ID (developer.apple.com → Membership,
# or `npx eas-cli credentials -p ios`). appID becomes <TEAMID>.com.zoyra.app
APPLE_TEAM_ID=

# Android App Links: SHA-256 signing cert fingerprints, comma-separated.
#   EAS-managed keystore: `npx eas-cli credentials -p android` → profile → "SHA256 Fingerprint"
#   Play App Signing (store builds are re-signed by Google!): Play Console → Setup → App signing →
#   "App signing key certificate" SHA-256. Add BOTH the upload/EAS key and the Play signing key.
ANDROID_SHA256_FINGERPRINTS=

# Optional
# APP_STORE_URL=https://apps.apple.com/app/id0000000000   # shows the App Store button + Smart App Banner
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.zoyra.app
# ZOYRA_API_URL=https://zoyra-backend-undj.onrender.com     # better titles for yt_ songs (else YouTube oEmbed)
# IOS_BUNDLE_ID=com.zoyra.app
# ANDROID_PACKAGE=com.zoyra.app
